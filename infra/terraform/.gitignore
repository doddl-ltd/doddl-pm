# Never commit — contain credentials and environment-specific values
terraform.tfvars
*.tfvars
!*.tfvars.example

# Terraform state files — managed in Azure Blob Storage (remote backend)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
